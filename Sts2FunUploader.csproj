<Project Sdk="Microsoft.NET.Sdk">
  <!-- sts2.fun uploader: a Slay the Spire 2 mod that sends finished runs (.run
       files) to https://sts2.fun. Builds against the game's own assemblies. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>sts2fun_uploader</AssemblyName>
    <RootNamespace>Sts2FunUploader</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.steam/steam/steamapps/common/Slay the Spire 2</GameDir>
    <GameData>$(GameDir)/data_sts2_linuxbsd_x86_64</GameData>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameData)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameData)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameData)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
